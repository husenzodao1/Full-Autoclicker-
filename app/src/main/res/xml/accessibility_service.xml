<?xml version="1.0" encoding="utf-8"?>
<!-- No accessibility events and no window content are requested.
     Key filtering is declared here but switched on at runtime only while ARMED. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/a11y_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:settingsActivity="com.fullautoclicker.ui.MainActivity"
    android:summary="@string/a11y_summary" />
