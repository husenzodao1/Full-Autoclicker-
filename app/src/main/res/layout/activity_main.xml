<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/exo2"
            android:letterSpacing="-0.01"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textFontWeight="800"
            android:textSize="30sp" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <Button
            android:id="@+id/btn_language"
            style="@style/Btn.Chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- 1 · Accessibility access -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/card_setup" />

            <TextView
                android:id="@+id/service_status"
                style="@style/Body"
                android:fontFamily="@font/onest"
                android:textFontWeight="500" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_enable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_enable" />

                <Button
                    android:id="@+id/btn_app_info"
                    style="@style/Btn.Ghost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_app_info" />
            </LinearLayout>

            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/setup_help"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 2 · Control -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/card_control" />

            <!-- Fixed height so status changes never shift the test pad below. -->
            <TextView
                android:id="@+id/mode_status"
                style="@style/Body"
                android:ellipsize="end"
                android:lines="4"
                android:textColor="@color/text" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btn_show"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_show" />

                <Button
                    android:id="@+id/btn_stop"
                    style="@style/Btn.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/btn_stop" />
            </LinearLayout>


            <TextView
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:text="@string/control_help"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 3 · Steps: what one Volume Up press does -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/card_steps" />

            <TextView
                style="@style/Body"
                android:text="@string/steps_help"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/default_hold"
                    android:text="@string/default_hold_label"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/default_hold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_ms"
                    android:textColor="@color/subtext" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/default_gap"
                    android:text="@string/default_gap_label"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/default_gap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_ms"
                    android:textColor="@color/subtext" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/default_path"
                    android:text="@string/default_path_label"
                    android:textColor="@color/text" />

                <EditText
                    android:id="@+id/default_path"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unit_ms"
                    android:textColor="@color/subtext" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/steps_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/steps_total"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textColor="@color/text" />
        </LinearLayout>

        <!-- 4 · Test and latency -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/card_test" />

            <com.fullautoclicker.ui.TestPadView
                android:id="@+id/test_pad"
                android:layout_width="match_parent"
                android:layout_height="160dp" />

            <TextView
                android:id="@+id/latency_text"
                style="@style/Body"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/pad_text"
                style="@style/Body"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_reset"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:text="@string/btn_reset" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
